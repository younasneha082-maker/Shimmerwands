<!-- High-Definition Product Zoom Lightbox Modal -->
<div id="product-zoom-modal" class="zoom-lightbox-modal" aria-hidden="true">
  <div class="zoom-lightbox-backdrop" id="zoom-backdrop"></div>
  
  <!-- Top Floating Toolbar -->
  <div class="zoom-toolbar">
    <div class="zoom-product-title-badge">
      <span id="zoom-modal-title">Product Image</span>
    </div>
    <div class="zoom-controls-group">
      <button id="btn-zoom-in" class="zoom-btn" title="Zoom In (+)" aria-label="Zoom In">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
      </button>
      <button id="btn-zoom-out" class="zoom-btn" title="Zoom Out (-)" aria-label="Zoom Out">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
      </button>
      <button id="btn-zoom-reset" class="zoom-btn" title="Reset Zoom" aria-label="Reset Zoom">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
      </button>
      <button id="btn-close-zoom-modal" class="zoom-btn zoom-btn-close" title="Close (Esc)" aria-label="Close Zoom">
        &times;
      </button>
    </div>
  </div>

  <!-- Zoom Pan Viewport -->
  <div class="zoom-viewport" id="zoom-viewport">
    <div class="zoom-image-stage" id="zoom-image-stage">
      <img id="zoom-modal-img" src="{{ 'main_page_1.png' | asset_url }}" alt="Zoomed Product View" draggable="false">
    </div>
  </div>

  <!-- Bottom Navigation & Counter -->
  <div class="zoom-bottom-bar">
    <button id="zoom-prev-btn" class="zoom-nav-btn prev" aria-label="Previous Image">❮</button>
    <span id="zoom-img-counter" class="zoom-counter">1 / 1</span>
    <button id="zoom-next-btn" class="zoom-nav-btn next" aria-label="Next Image">❯</button>
    <div class="zoom-drag-hint">
      <span>Drag to pan &bull; Scroll / Pinch to zoom &bull; Double-click to toggle</span>
    </div>
  </div>
</div>
