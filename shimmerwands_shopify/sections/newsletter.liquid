<section class="container" id="discount">
  <div class="newsletter-card">
    <div class="section-tag" style="color: var(--charcoal);">{{ section.settings.tag | default: 'SPARKLE CLUB VIP' }}</div>
    <h2 class="section-title" style="color: var(--charcoal); font-size: 2.2rem;">{{ section.settings.heading | default: 'Get 5% Off On Your First Wand Order' }}</h2>
    <p style="font-size: 0.95rem; margin-top: 10px;">
      {{ section.settings.subheading | default: 'Be the first to know about new rhinestone edits, VIP sales & secret drops. Enter your email to claim your discount.' }}
    </p>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter, 5off-vip">
      {%- if form.posted_successfully? -%}
        <div style="background: rgba(255,255,255,0.9); padding: 12px 20px; border-radius: 20px; font-weight: 600; color: #047857;">
          ✨ Welcome to the Sparkle Club! Check your inbox for your 5% discount code.
        </div>
      {%- else -%}
        <input 
          type="email" 
          name="contact[email]" 
          class="newsletter-input" 
          placeholder="Enter your email for sparkle perks..." 
          required
          value="{{ form.email }}"
        >
        <button type="submit" class="btn-sparkle" style="background: var(--charcoal);">JOIN CLUB ✨</button>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "SPARKLE CLUB VIP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 5% Off On Your First Wand Order"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be the first to know about new rhinestone edits, VIP sales & secret drops. Enter your email to claim your discount."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
