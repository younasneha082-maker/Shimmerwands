<section class="products-section container" style="padding-top: 40px; padding-bottom: 80px;">
  <div class="section-header">
    <span class="section-tag">CATALOG</span>
    <h1 class="section-title">{{ collection.title | default: 'All Sparkle Wands' }}</h1>
    {%- if collection.description != blank -%}
      <p class="section-script">{{ collection.description }}</p>
    {%- endif -%}
  </div>

  {% paginate collection.products by 16 %}
    <div class="product-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px;">
          <p style="font-family: var(--font-heading); font-size: 1.4rem;">No products found in this collection.</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="display: flex; justify-content: center; gap: 10px; margin-top: 40px;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection Page",
  "settings": []
}
{% endschema %}
