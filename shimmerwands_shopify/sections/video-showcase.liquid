<section id="product-videos" class="videos-section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">{{ section.settings.section_tag | default: 'SPARKLE IN MOTION' }}</div>
      <h2 class="section-title">{{ section.settings.heading | default: 'Watch Our Wands in Action ✨' }}</h2>
    </div>

    <div class="video-grid-container">
      <!-- Row 1: Main Video -->
      <div class="video-row main-video-row">
        <div class="video-card main-video-card">
          <div class="video-wrapper">
            <video autoplay muted loop playsinline preload="auto">
              {%- if section.settings.main_video != blank -%}
                {{ section.settings.main_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true }}
              {%- else -%}
                <source src="{{ 'vid1.mp4' | asset_url }}" type="video/mp4">
              {%- endif -%}
            </video>
          </div>
        </div>
      </div>

      <!-- Row 2: Secondary Looping Videos -->
      <div class="video-row secondary-video-row">
        <div class="video-card secondary-video-card">
          <div class="video-wrapper">
            <video autoplay muted loop playsinline preload="auto">
              <source src="{{ 'vid2.mp4' | asset_url }}" type="video/mp4">
            </video>
          </div>
        </div>
        <div class="video-card secondary-video-card">
          <div class="video-wrapper">
            <video autoplay muted loop playsinline preload="auto">
              <source src="{{ 'vid3.mp4' | asset_url }}" type="video/mp4">
            </video>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Showcase",
  "settings": [
    {
      "type": "text",
      "id": "section_tag",
      "label": "Section Tag",
      "default": "SPARKLE IN MOTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Our Wands in Action ✨"
    },
    {
      "type": "video",
      "id": "main_video",
      "label": "Main Featured Video (Optional Upload)"
    }
  ],
  "presets": [
    {
      "name": "Video Showcase"
    }
  ]
}
{% endschema %}
