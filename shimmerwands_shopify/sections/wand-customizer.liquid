<section id="customizer" class="customizer-section">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">{{ section.settings.section_tag | default: 'CUSTOM BRUSH BUILDER' }}</div>
      <h2 class="section-title">{{ section.settings.heading | default: 'Design Your Custom Rhinestone Wand' }}</h2>
    </div>

    <div class="customizer-card">
      <!-- Live SVG Brush Preview -->
      <div class="customizer-preview">
        <div class="wand-svg-container">
          <svg viewBox="0 0 100 300" width="100%" height="100%">
            <defs>
              <linearGradient id="grad-rose-gold" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fce4e1"/>
                <stop offset="50%" stop-color="#d6a7a1"/>
                <stop offset="100%" stop-color="#b8736d"/>
              </linearGradient>

              <linearGradient id="grad-diamond" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="50%" stop-color="#e2e8f0"/>
                <stop offset="100%" stop-color="#cbd5e1"/>
              </linearGradient>

              <linearGradient id="grad-pink-sapphire" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fbcfe8"/>
                <stop offset="50%" stop-color="#f472b6"/>
                <stop offset="100%" stop-color="#db2777"/>
              </linearGradient>

              <linearGradient id="grad-champagne-gold" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fef3c7"/>
                <stop offset="50%" stop-color="#f59e0b"/>
                <stop offset="100%" stop-color="#b45309"/>
              </linearGradient>

              <linearGradient id="grad-amethyst-violet" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#f3e8ff"/>
                <stop offset="50%" stop-color="#c084fc"/>
                <stop offset="100%" stop-color="#7e22ce"/>
              </linearGradient>

              <linearGradient id="grad-ruby-sparkle" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fecdd3"/>
                <stop offset="50%" stop-color="#f43f5e"/>
                <stop offset="100%" stop-color="#be123c"/>
              </linearGradient>

              <linearGradient id="grad-emerald-luxe" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#a7f3d0"/>
                <stop offset="50%" stop-color="#10b981"/>
                <stop offset="100%" stop-color="#047857"/>
              </linearGradient>

              <linearGradient id="grad-midnight-onyx" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#64748b"/>
                <stop offset="50%" stop-color="#1e293b"/>
                <stop offset="100%" stop-color="#0f172a"/>
              </linearGradient>

              <linearGradient id="grad-bristle-pink" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#f472b6"/>
                <stop offset="50%" stop-color="#fbcfe8"/>
                <stop offset="100%" stop-color="#ffffff"/>
              </linearGradient>
            </defs>

            <path id="wand-bristles" d="M 25,90 C 20,40 30,10 50,10 C 70,10 80,40 75,90 Z" fill="url(#grad-bristle-pink)" />
            <rect x="28" y="90" width="44" height="30" rx="4" fill="url(#grad-champagne-gold)" stroke="#b45309" stroke-width="0.5"/>
            <path id="wand-handle-fill" d="M 32,120 L 38,275 C 38,285 62,285 62,275 L 68,120 Z" fill="url(#grad-rose-gold)" />

            <g id="wand-gems">
              <circle cx="36" cy="140" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="44" cy="140" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="52" cy="140" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="60" cy="140" r="2.5" fill="#ffffff" opacity="0.95"/>

              <circle cx="38" cy="165" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="46" cy="165" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="54" cy="165" r="2.5" fill="#ffffff" opacity="0.95"/>

              <circle cx="40" cy="190" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="48" cy="190" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="56" cy="190" r="2.5" fill="#ffffff" opacity="0.95"/>

              <circle cx="42" cy="215" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="50" cy="215" r="2.5" fill="#ffffff" opacity="0.95"/>

              <circle cx="44" cy="240" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="52" cy="240" r="2.5" fill="#ffffff" opacity="0.95"/>
              <circle cx="48" cy="265" r="3" fill="#ffffff" opacity="0.95"/>
            </g>
          </svg>
        </div>

        <div id="monogram-tag-display" class="monogram-tag-preview">S</div>
      </div>

      <!-- Customizer Controls -->
      <div class="customizer-controls">
        <!-- 1. Background / Handle Rhinestone Color -->
        <div class="option-group">
          <div class="option-label">
            1. BACKGROUND COLOR: <span id="selected-handle-name">ROSE GOLD</span>
          </div>
          <div class="swatch-picker-grid">
            <div class="swatch-item active" data-type="bg" data-value="rose-gold" data-name="ROSE GOLD">
              <div class="swatch swatch-rose-gold"></div>
              <span class="swatch-name">Rose Gold</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="diamond" data-name="CRYSTAL DIAMOND">
              <div class="swatch swatch-diamond"></div>
              <span class="swatch-name">Diamond</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="pink-sapphire" data-name="PINK SAPPHIRE">
              <div class="swatch swatch-pink-sapphire"></div>
              <span class="swatch-name">Pink Sapphire</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="champagne-gold" data-name="CHAMPAGNE GOLD">
              <div class="swatch swatch-champagne-gold"></div>
              <span class="swatch-name">Champagne</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="amethyst-violet" data-name="AMETHYST VIOLET">
              <div class="swatch swatch-amethyst-violet"></div>
              <span class="swatch-name">Amethyst</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="ruby-sparkle" data-name="RUBY RED">
              <div class="swatch swatch-ruby-sparkle"></div>
              <span class="swatch-name">Ruby Red</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="emerald-luxe" data-name="EMERALD LUXE">
              <div class="swatch swatch-emerald-luxe"></div>
              <span class="swatch-name">Emerald</span>
            </div>
            <div class="swatch-item" data-type="bg" data-value="midnight-onyx" data-name="MIDNIGHT ONYX">
              <div class="swatch swatch-midnight-onyx"></div>
              <span class="swatch-name">Midnight</span>
            </div>
          </div>
        </div>

        <!-- 2. Monogram Tag Color -->
        <div class="option-group">
          <div class="option-label">
            2. MONOGRAM BADGE COLOR: <span id="selected-mono-name">ROSE GOLD</span>
          </div>
          <div class="swatch-picker-grid">
            <div class="swatch-item active" data-type="mono" data-bg="#d6a7a1" data-color="#ffffff" data-name="ROSE GOLD">
              <div class="swatch swatch-mono-rose-gold"></div>
              <span class="swatch-name">Rose Gold</span>
            </div>
            <div class="swatch-item" data-type="mono" data-bg="#ffffff" data-color="#1f1a1a" data-name="DIAMOND WHITE">
              <div class="swatch swatch-mono-diamond"></div>
              <span class="swatch-name">Diamond</span>
            </div>
            <div class="swatch-item" data-type="mono" data-bg="#f7d6dc" data-color="#b8736d" data-name="PINK BLUSH">
              <div class="swatch swatch-mono-blush"></div>
              <span class="swatch-name">Blush</span>
            </div>
            <div class="swatch-item" data-type="mono" data-bg="#e6c594" data-color="#1f1a1a" data-name="CHAMPAGNE GOLD">
              <div class="swatch swatch-mono-champagne"></div>
              <span class="swatch-name">Champagne</span>
            </div>
            <div class="swatch-item" data-type="mono" data-bg="#fbf8f5" data-color="#b8736d" data-name="PEARL WHITE">
              <div class="swatch swatch-mono-pearl"></div>
              <span class="swatch-name">Pearl</span>
            </div>
            <div class="swatch-item" data-type="mono" data-bg="#1f1a1a" data-color="#f5dce1" data-name="VELVET BLACK">
              <div class="swatch swatch-mono-black"></div>
              <span class="swatch-name">Onyx</span>
            </div>
          </div>
        </div>

        <!-- Monogram Text Input -->
        <div class="option-group">
          <div class="option-label">
            ENGRAVED FERRULE MONOGRAM (1 LETTER):
          </div>
          <input type="text" id="monogram-input" class="monogram-input" placeholder="e.g. S" maxlength="1">
        </div>

        <!-- Action Button -->
        {%- if section.settings.custom_product != blank -%}
          <button 
            id="btn-add-custom-wand" 
            class="btn-sparkle" 
            data-variant-id="{{ section.settings.custom_product.selected_or_first_available_variant.id }}"
            style="width: 100%; justify-content: center; margin-top: 10px;"
          >
            + ADD CUSTOM WAND TO BAG ✨
          </button>
        {%- else -%}
          <button 
            id="btn-add-custom-wand" 
            class="btn-sparkle btn-unavailable" 
            disabled 
            style="width: 100%; justify-content: center; margin-top: 10px;"
          >
            UNAVAILABLE ✨
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wand Customizer",
  "settings": [
    {
      "type": "text",
      "id": "section_tag",
      "label": "Section Tag",
      "default": "CUSTOM BRUSH BUILDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design Your Custom Rhinestone Wand"
    },
    {
      "type": "product",
      "id": "custom_product",
      "label": "Linked Custom Wand Product (Optional)",
      "info": "Assign a product to enable live purchase of custom wands with line-item properties."
    }
  ],
  "presets": [
    {
      "name": "Wand Customizer"
    }
  ]
}
{% endschema %}
