{%- if section.settings.show_announcement -%}
  <div class="announcement-bar-wrapper" style="align-items: center; justify-content: center; background: var(--rose-gold-light); border-bottom: 1px solid var(--rose-gold-blush);">
    <a href="{{ section.settings.link | default: '#discount' }}" class="announcement-bar" title="{{ section.settings.text | escape }}">
      {{ section.settings.text }}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "✨ Get 5% off your first order! 🎀"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
