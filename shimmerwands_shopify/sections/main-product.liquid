<div class="product-page-view-wrapper">
  <!-- Sticky Product Page Header Nav -->
  <div class="product-page-nav">
    <a href="{{ routes.root_url }}#shop" id="btn-back-storefront" class="btn-back-nav" style="text-decoration: none;">
      ❮ Back to Storefront
    </a>
    <div class="product-page-brand">
      <span class="logo-title" style="font-size: 1.4rem; font-family: var(--font-heading); color: var(--rose-gold-dark);">Shimmerwands</span>
    </div>
    <button id="product-page-cart-btn" class="icon-btn" title="Shopping Bag" style="position: relative;">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="cart-badge" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>{{ cart.item_count }}</span>
    </button>
  </div>

  <!-- Main Content -->
  <div class="container product-page-container">
    <!-- Left Column: Interactive Gallery & Thumbnails -->
    <div class="product-page-gallery">
      <div class="product-page-main-img-box" id="product-zoom-box">
        {%- if product.featured_image -%}
          <img 
            id="product-page-img" 
            src="{{ product.featured_image | image_url: width: 1200 }}" 
            alt="{{ product.title | escape }}"
          >
        {%- else -%}
          <img id="product-page-img" src="{{ 'main_page_1.png' | asset_url }}" alt="{{ product.title | escape }}">
        {%- endif -%}

        {%- if product.images.size > 1 -%}
          <button id="product-page-prev-btn" class="slider-btn prev-btn modal-slider-btn prev" aria-label="Previous image">❮</button>
          <button id="product-page-next-btn" class="slider-btn next-btn modal-slider-btn next" aria-label="Next image">❯</button>
          <span id="product-page-img-counter" class="img-counter-badge">1 / {{ product.images.size }}</span>
        {%- endif -%}
        
        <!-- Zoom Toggle Badge -->
        <div class="product-zoom-badge" id="product-zoom-hint" title="Hover or tap to zoom">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          <span class="zoom-badge-text" id="zoom-badge-text">Zoom ✨</span>
        </div>

        <!-- Fullscreen Lightbox Button -->
        <button id="btn-fullscreen-expand" class="product-expand-badge" title="Open Fullscreen HD Zoom" aria-label="Fullscreen Zoom">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          <span>Expand ⛶</span>
        </button>
      </div>

      <!-- Thumbnail Row -->
      {%- if product.images.size > 1 -%}
        <div id="product-page-thumbnails" class="product-thumbnails-row">
          {%- for image in product.images -%}
            <div class="thumb-item {% if forloop.first %}active{% endif %}" data-img-src="{{ image | image_url: width: 1200 }}" data-index="{{ forloop.index0 }}">
              <img src="{{ image | image_url: width: 150 }}" alt="Thumbnail {{ forloop.index }}">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Right Column: Product Specs & Purchase Options -->
    <div class="product-page-details">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px;">
        <span class="section-tag" id="product-page-category">{{ product.type | default: 'RHINESTONE WANDS' | upcase }}</span>
        {%- if product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
          <span id="product-page-badge" class="product-badge-pill">BESTSELLER</span>
        {%- endif -%}
      </div>

      <h1 id="product-page-title" class="product-page-h1">{{ product.title }}</h1>
      <p id="product-page-sub" class="product-page-sub-text">{{ product.metafields.descriptors.subtitle.value | default: 'Premium Handcrafted Luxury Wand' }}</p>

      <div class="product-page-price-row">
        <span id="product-page-price" class="product-page-price-text">{{ product.price | money }}</span>
        <span id="product-page-stock" class="stock-status-pill">
          {% if product.available %}In Stock ✨{% else %}Unavailable ❌{% endif %}
        </span>
      </div>

      <!-- Craftsmanship & Detailed Description -->
      <div class="product-description-block">
        <h3>Craftsmanship & Details</h3>
        <div id="product-page-desc">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>Handcrafted with premium light-refracting rhinestones and ultra-soft, cruelty-free synthetic fibers. Designed for smooth, flawless application and long-lasting artistry.</p>
          {%- endif -%}
        </div>
      </div>

      <!-- Specifications Grid -->
      <div class="product-specs-grid">
        <div class="spec-card">
          <span class="spec-title">COLOR FINISH</span>
          <span id="product-page-color" class="spec-value">Rose Gold</span>
        </div>
        <div class="spec-card">
          <span class="spec-title">BRISTLE TYPE</span>
          <span class="spec-value">Ultra-Soft Synthetic</span>
        </div>
        <div class="spec-card">
          <span class="spec-title">HANDLE STYLE</span>
          <span class="spec-value">Rhinestone Embedded</span>
        </div>
        <div class="spec-card">
          <span class="spec-title">DURABILITY</span>
          <span class="spec-value">Deep-Wash Tested</span>
        </div>
      </div>

      <!-- Purchase Action Controls with Native Shopify Form -->
      {% form 'product', product, id: 'product-form-installment' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <div class="product-actions-box">
          <div class="qty-selector-large">
            <button type="button" id="product-page-qty-minus" class="qty-btn-large">-</button>
            <input type="number" id="product-page-qty-val" name="quantity" value="1" min="1" class="qty-val-large" style="border:none; text-align:center; width:45px; background:transparent;">
            <button type="button" id="product-page-qty-plus" class="qty-btn-large">+</button>
          </div>

          {%- if product.available -%}
            <button type="submit" name="add" id="product-page-add-bag" class="btn-sparkle btn-large-purchase">
              + ADD TO BAG ✨
            </button>
            <button type="button" id="product-page-buy-now" class="btn-secondary btn-large-purchase" onclick="window.location.href='/checkout'">
              BUY NOW ⚡
            </button>
          {%- else -%}
            <button type="button" class="btn-sparkle btn-large-purchase" disabled style="opacity: 0.5;">
              UNAVAILABLE ❌
            </button>
          {%- endif -%}
        </div>
      {% endform %}

      <!-- Trust Badges -->
      <div class="product-trust-row">
        <div class="trust-item">🚚 <span>Free Shipping > PKR 7,500</span></div>
        <div class="trust-item">💵 <span>Cash on Delivery</span></div>
      </div>
    </div>
  </div>
</div>

<script>
  // Expose product gallery images to the Zoom Lightbox Modal
  window.currentProductGallery = [
    {%- for image in product.images -%}
      "{{ image | image_url: width: 1400 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];
  window.currentProductGalleryIdx = 0;
  window.currentProductTitle = {{ product.title | json }};
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
