<section id="story" class="story-section">
  <div class="container story-grid">
    <div class="story-visual">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.quote | escape }}" class="story-img-main">
      {%- else -%}
        <img src="{{ 'brand_story_asset.png' | asset_url }}" alt="Shimmerwands Brand Story" class="story-img-main">
      {%- endif -%}
      <div class="story-quote-card">
        <div class="story-quote-text">"{{ section.settings.quote | default: 'Beauty meets bling.' }}"</div>
      </div>
    </div>

    <div class="story-content">
      <div class="section-tag">{{ section.settings.tag | default: 'OUR STORY & ARTISTRY' }}</div>
      <h2 class="section-title" style="margin-bottom: 16px;">{{ section.settings.heading | default: 'Crafted for the Glamorous' }}</h2>
      <p style="font-size: 0.95rem; color: #555; line-height: 1.7; margin-bottom: 24px;">
        {{ section.settings.text | default: 'Each wand is individually hand-embellished with hundreds of brilliant light-refracting rhinestones. Designed to transform your daily beauty routine into a royal pampering ritual.' }}
      </p>

      <div style="display: flex; gap: 30px; margin-top: 30px;">
        <div>
          <div style="font-family: var(--font-heading); font-size: 2.2rem; color: var(--rose-gold-dark);">{{ section.settings.stat1_num | default: '100%' }}</div>
          <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1.5px; color: #777;">{{ section.settings.stat1_label | default: 'Rhinestone Elegance' }}</div>
        </div>
        <div>
          <div style="font-family: var(--font-heading); font-size: 2.2rem; color: var(--rose-gold-dark);">{{ section.settings.stat2_num | default: '50K+' }}</div>
          <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1.5px; color: #777;">{{ section.settings.stat2_label | default: 'Sparkling Beauties Worldwide' }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "OUR STORY & ARTISTRY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for the Glamorous"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Story Paragraph",
      "default": "Each wand is individually hand-embellished with hundreds of brilliant light-refracting rhinestones. Designed to transform your daily beauty routine into a royal pampering ritual."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Visual Image"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote Card Text",
      "default": "Beauty meets bling."
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "Rhinestone Elegance"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 Number",
      "default": "50K+"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "Sparkling Beauties Worldwide"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
