<section id="hero" class="hero">
  <div class="container hero-container" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0;">
    <div class="hero-visual">
      <div class="mouse-light-sweep"></div>

      <!-- Hero Multi-Image Interactive Slider -->
      <div class="hero-image-card">
        <div id="hero-slider" class="hero-slider">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="hero-slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.alt | default: 'Shimmerwands Slide' }}">
                {%- else -%}
                  {%- assign default_img_name = 'main_page_' | append: forloop.index | append: '.png' -%}
                  <img src="{{ default_img_name | asset_url }}" alt="Shimmerwands Main Slide {{ forloop.index }}">
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback 5 Core Slides -->
            <div class="hero-slide active"><img src="{{ 'main_page_1.png' | asset_url }}" alt="Slide 1"></div>
            <div class="hero-slide"><img src="{{ 'main_page_2.png' | asset_url }}" alt="Slide 2"></div>
            <div class="hero-slide"><img src="{{ 'main_page_3.png' | asset_url }}" alt="Slide 3"></div>
            <div class="hero-slide"><img src="{{ 'main_page_4.png' | asset_url }}" alt="Slide 4"></div>
            <div class="hero-slide"><img src="{{ 'main_page_5.png' | asset_url }}" alt="Slide 5"></div>
          {%- endif -%}
        </div>

        <!-- Slider Navigation Arrows -->
        <button id="hero-prev-btn" class="slider-btn prev-btn" aria-label="Previous Slide">❮</button>
        <button id="hero-next-btn" class="slider-btn next-btn" aria-label="Next Slide">❯</button>

        <!-- Slider Dot Indicators -->
        <div id="hero-dots" class="slider-dots">
          {%- assign slide_count = section.blocks.size -%}
          {%- if slide_count == 0 -%}{%- assign slide_count = 5 -%}{%- endif -%}
          {%- for i in (1..slide_count) -%}
            {%- assign zero_index = forloop.index0 -%}
            <span class="dot {% if forloop.first %}active{% endif %}" data-slide="{{ zero_index }}"></span>
          {%- endfor -%}
        </div>

        <!-- Action Buttons Overlay On Top of Image -->
        <div class="cta-group hero-cta-overlay">
          <a href="{{ section.settings.primary_cta_link | default: '#shop' }}" class="btn-sparkle">
            {{ section.settings.primary_cta_text | default: 'EXPLORE COLLECTION ✨' }}
          </a>
          <a href="{{ section.settings.secondary_cta_link | default: '#customizer' }}" class="btn-secondary">
            {{ section.settings.secondary_cta_text | default: 'CUSTOM RHINESTONE 💎' }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Slider",
  "settings": [
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "EXPLORE COLLECTION ✨"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Text",
      "default": "CUSTOM RHINESTONE 💎"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Button Link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text",
          "default": "Luxury Sparkle Wand"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider"
    }
  ]
}
{% endschema %}
